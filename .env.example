# 로컬 채팅에 필수. 실제 키를 커밋하지 마세요.
DEEPSEEK_API_KEY=your-deepseek-api-key
# 기본값: deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
# 선택: 비워 두면 키 없는 Exa MCP 검색 사용
EXA_API_KEY=

# Slack 모드에서만 필수; CLI에는 필요 없음. 실제 토큰을 커밋하지 마세요.
# Bot User OAuth Token: xoxb- (사용자 xoxp- 토큰 불가)
SLACK_BOT_TOKEN=
# App-Level Token: xapp-, connections:write 필요
SLACK_APP_TOKEN=

# Slack DM 전용 영속 저장소. 기본 .local/slack-history/history.sqlite
# 로컬 전용 private owner 디렉터리. 배포는 Compose 고정 경로를 사용(호스트 env에 추가하지 않음).
# SLACK_HISTORY_DB=.local/slack-history/history.sqlite

# 선택: 셋 모두 비어 있으면 이미지 분석 unavailable. DeepSeek/실행 모델 상속 없음.
# 별도 이미지 지원 공급자 HTTPS public root 또는 /v1 endpoint. inline 이미지 외부 전송 승인 필요.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
