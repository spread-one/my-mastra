# 로컬 채팅에 필수. 실제 키를 커밋하지 마세요.
DEEPSEEK_API_KEY=your-deepseek-api-key
# 기본값: deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
# 선택: 비워 두면 키 없는 Exa MCP 검색 사용
EXA_API_KEY=

# Slack 모드에서만 필수; CLI에는 필요 없음. 실제 토큰을 커밋하지 마세요.
# Bot User OAuth Token: xoxb- (사용자 xoxp- 토큰 불가)
SLACK_BOT_TOKEN=
# App-Level Token: xapp-, connections:write 필요
SLACK_APP_TOKEN=
